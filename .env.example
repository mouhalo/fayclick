# ========================================
# Configuration FayClick V2
# ========================================
# IMPORTANT: Ce fichier contient 2 configurations FTP distinctes !
# Ne PAS confondre les deux utilisateurs FTP :
# - FTP_* = Déploiement du SITE (userv2 → v2.fayclick.net)
# - FTP_UPLOAD_* = Upload PHOTOS/LOGOS (uploadv2 → fayclick.net/uploads)
# ========================================

# ────────────────────────────────────────
# 1️⃣  Configuration FTP - DÉPLOIEMENT DU SITE
# ────────────────────────────────────────
# Utilisé par: deploy.mjs, clean-server.mjs
# Cible: v2.fayclick.net (sous-domaine site Next.js)
# User: userv2@fayclick.net

FTP_HOST=node260-eu.n0c.com
FTP_USER=userv2@fayclick.net
FTP_PASSWORD=votre_password_ici
FTP_SITE_PATH=/
FTP_PORT=21
FTP_SECURE=false
FTP_SFTP=false

SITE_URL=https://v2.fayclick.net

# ────────────────────────────────────────
# 2️⃣  Configuration FTP - UPLOAD PHOTOS/LOGOS
# ────────────────────────────────────────
# Utilisé par: app/api/upload-logo/route.ts
# Cible: fayclick.net/uploads (domaine principal)
# User: uploadv2@fayclick.net

FTP_UPLOAD_HOST=node260-eu.n0c.com
FTP_UPLOAD_USER=uploadv2@fayclick.net
FTP_UPLOAD_PASSWORD=votre_password_ici
FTP_UPLOAD_PATH=/uploads/
FTP_UPLOAD_PORT=21
FTP_UPLOAD_SECURE=false
FTP_UPLOAD_SFTP=false

SITE_UPLOAD_URL=https://fayclick.net

# ────────────────────────────────────────
# 3️⃣  Configuration API
# ────────────────────────────────────────

MODE=DEVELOPMENT
#MODE=PRODUCTION

NEXT_PUBLIC_API_URL_DEV=https://api.icelabsoft.com/api/psql_request/api/psql_request
NEXT_PUBLIC_API_URL_PROD=https://api.icelabsoft.com/api/psql_request/api/psql_request

# API Upload Logo/Photos (backend qui gère le FTP)
NEXT_PUBLIC_UPLOAD_API_URL=https://api.icelabsoft.com/upload/logo

# Clé X-App-Key sql_jsonpro (hors dépôt — mettre la vraie valeur dans .env / .env.local)
# SQL_APP_KEY=

# ────────────────────────────────────────
# 4️⃣  Endpoints Externes
# ────────────────────────────────────────

ORANGE_ENDPOINT=https://api.icelabsoft.com/orange/pay_om

# ────────────────────────────────────────
# 5️⃣  URL Application (Legacy)
# ────────────────────────────────────────

NEXT_PUBLIC_APP_BASE_URL=https://v2.fayclick.net

# ========================================
# 📝 Notes Importantes
# ========================================
#
# ⚠️  NE JAMAIS CONFONDRE :
#   - deploy.mjs → utilise FTP_* (userv2)
#   - upload logos → utilise FTP_UPLOAD_* (uploadv2)
#
# 🔒 Sécurité :
#   - Ce fichier .env.example est PUBLIC (git)
#   - Remplacer "votre_password_ici" par vrais passwords
#   - Fichier .env réel est dans .gitignore
#
# 🚀 Utilisation :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir les passwords réels
#   3. Vérifier les paths FTP_SITE_PATH et FTP_UPLOAD_PATH
#
# ========================================